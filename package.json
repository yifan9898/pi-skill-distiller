	"license": "MIT",
	"author": "yifan9898 <weiy6@seas.upenn.edu>",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/yifan9898/pi-skill-distiller.git"
	},
	"homepage": "https://github.com/yifan9898/pi-skill-distiller#readme",
	"bugs": {
		"url": "https://github.com/yifan9898/pi-skill-distiller/issues"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"skills",
		"distillation"
	],
	"files": [
